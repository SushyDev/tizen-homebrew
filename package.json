{
  "name": "tizen-homebrew",
  "version": "0.1.0",
  "private": true,
  "description": "Install apps on a Samsung Tizen TV from your phone.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SushyDev/tizen-homebrew.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "service",
    "ui"
  ],
  "scripts": {
    "doctor": "node tools/doctor.js",
    "lint": "eslint .",
    "build": "node tools/build.js",
    "test": "node tools/test.js",
    "package": "node tools/package.js",
    "bootstrap": "node tools/bootstrap.js",
    "duid": "node tools/duid.js",
    "certs": "node tools/certs.js",
    "push": "node tools/push.js",
    "dev": "npm run dev --workspace ui",
    "dev:service": "node service/src/main.js",
    "clean": "node tools/clean.js",
    "version": "node tools/version.js",
    "version:check": "node tools/version.js --check"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "tizen": "https://github.com/reisxd/tizen.js/tarball/main",
    "ws": "^8.21.3"
  }
}
